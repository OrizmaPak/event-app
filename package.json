{
  "name": "nasa-event-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build",
    "test:unit": "tsx --test tests/auth-redirect.test.ts",
    "test:analytics": "tsx --test tests/event-analytics.test.ts",
    "test:analytics:integration": "tsx scripts/test-event-analytics.ts",
    "test:resources": "tsx --test tests/resources.test.ts",
    "test:resources:integration": "tsx scripts/test-resources.ts",
    "db:backfill-simulated-payments": "tsx scripts/backfill-simulated-payments.ts",
    "test:smoke": "tsx scripts/smoke-app.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-neon.ts",
    "db:seed": "tsx scripts/seed-neon.ts",
    "db:seed-resources": "tsx scripts/seed-resources.ts",
    "db:reset-demo": "tsx scripts/reset-neon-demo.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-orm": "0.45.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "nodemailer": "^10.1.1",
    "otpauth": "^9.5.2",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "NASA EVENT Frontend Foundation"
}
