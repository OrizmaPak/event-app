# Public application URL
NEXT_PUBLIC_APP_URL=http://127.0.0.1:5180

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Use at least 32 random bytes for signing and encryption secrets
AUTH_SECRET=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
INVITATION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# Paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend email
RESEND_API_KEY=
EMAIL_FROM=NASA EVENT <tickets@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
GMAIL_USER=
GMAIL_PASS=
GMAIL_FROM=

# Termii SMS
TERMII_API_KEY=
TERMII_SENDER_ID=NASAEvent

# Cloudinary media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
